# ══════════════════════════════════════════════════════════════
#  Configuration RAG-DataAfriqueHub
#  Copiez ce fichier en .env et remplissez les valeurs requises.
# ══════════════════════════════════════════════════════════════

# Mode actif du pipeline : free | hybrid | premium
RAG_CONFIG=hybrid

# ── Mode FREE (free.yaml) ─────────────────────────────────────
# Requiert : GOOGLE_API_KEY (même clé que le mode hybrid)
# Provider LLM : Gemini 2.0 Flash (Google AI Studio) → https://aistudio.google.com/apikey
# Gratuit, sans carte bancaire, 1 500 requêtes/jour
GOOGLE_API_KEY=

# Alternative payante : Cerebras — nécessite une carte bancaire
# CEREBRAS_API_KEY=csk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternative gratuite mais lente : HuggingFace
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Mode HYBRID (hybrid.yaml) ────────────────────────────────
# Requiert : MISTRAL_API_KEY + COHERE_API_KEY
# Provider LLM  : Mistral 7B (Mistral AI) → https://mistral.ai
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Requiert : GOOGLE_API_KEY + COHERE_API_KEY
# Provider LLM  : Gemini 2.0 Flash  → https://ai.google.dev
# Provider Rank : Cohere             → https://cohere.com
GOOGLE_API_KEY=

COHERE_API_KEY=

# ── Mode PREMIUM (premium.yaml) ──────────────────────────────
# Requiert : OPENAI_API_KEY + COHERE_API_KEY + PINECONE_API_KEY
# Provider LLM      : GPT-4 (OpenAI)
# Provider Embedding: text-embedding-3-large (OpenAI)
# Provider VectorDB : Pinecone (managed)
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1-aws

# ── Authentification API (optionnel) ─────────────────────────
# Si défini, toutes les routes requièrent le header : X-API-Key
# Laisser vide pour désactiver l'auth (mode local/dev)
# !! SECRET BACKEND UNIQUEMENT — ne JAMAIS le passer au frontend !!
# Toute variable VITE_* est bakée en clair dans le bundle JS public.
API_KEY=

# ── CORS (optionnel) ─────────────────────────────────────────
# Origines autorisées par le backend (virgule-séparées, sans espaces).
# En dev local : laisser vide — les valeurs par défaut (localhost) s'appliquent.
# En production : renseigner les domaines réels du frontend.
# Exemple : CORS_ORIGINS=https://mon-app.com,https://www.mon-app.com
CORS_ORIGINS=

# ── Frontend ─────────────────────────────────────────────────
# URL que le NAVIGATEUR utilise pour atteindre le backend.
# En local Docker : http://localhost:8000
# En production   : https://api.votre-domaine.com
# (Ce n'est PAS un secret — safe à passer comme variable VITE_*)
VITE_API_URL=http://localhost:8000
